{
  "name": "lagent",
  "productName": "lagent",
  "version": "0.1.2",
  "private": true,
  "description": "lagent — 多模型接入 / Skill 管理 / 工作区管理 / GitHub 直连编辑的 AI Agent 桌面工具",
  "main": "./out/main/index.js",
  "author": "lagent",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --no-warnings --import ./scripts/alias-register.mjs scripts/unit.mjs",
    "test:permissions": "node --no-warnings --import ./scripts/alias-register.mjs scripts/permission-adversarial.mjs",
    "test:plugins": "node --no-warnings scripts/plugin-e2e.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:package": "node --no-warnings scripts/package-smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run test:permissions && npm run test:plugins && npm run build && npm run test:smoke",
    "app": "node scripts/launch.mjs",
    "e2e": "node scripts/e2e-build.mjs",
    "dist": "node scripts/dist.mjs",
    "dist:win": "node scripts/dist.mjs win",
    "dist:mac": "node scripts/dist.mjs mac",
    "dist:linux": "node scripts/dist.mjs linux",
    "iss": "node scripts/make-iss.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
